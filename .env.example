# UORCA Environment Configuration Template
# ========================================
# Copy this file to '.env' and fill in your actual values
# Keep this file secure and never commit it to version control!

# Required: Your email address (NCBI Entrez API requirement)
# Any valid email address - required by NCBI guidelines for API access
ENTREZ_EMAIL=your.email@institution.edu

# Required: OpenAI API key for AI-powered analysis
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=<your-openai-api-key>

# Optional but recommended: NCBI API key for faster processing
# Get your FREE key from: https://www.ncbi.nlm.nih.gov/account/settings/
# Benefits: 10x faster database queries (10 req/sec vs 3 req/sec)
# Leave it commented out until you have a real key: a placeholder is rejected by NCBI.
# ENTREZ_API_KEY=your-ncbi-api-key-here

# Optional: choose the LLM (see "Choosing the AI model" in README.md)
# Precedence: these variables, then ~/.uorca/config.yaml (written by the app's
# Project Setup page), then the built-in default (OpenAI, gpt-5-mini).
# Each provider reads its own key variable; UORCA stops with a message naming it if unset.
#
# OpenAI (default):
# UORCA_AI_PROVIDER=openai           # or openai:<model>
# UORCA_OPENAI_MODEL=gpt-5-mini
#
# AWS Bedrock (needs AWS credentials, e.g. AWS_PROFILE and `aws sso login`):
# UORCA_AI_PROVIDER=bedrock
# UORCA_BEDROCK_MODEL=anthropic.claude-sonnet-4-5-20250929-v1:0
# UORCA_BEDROCK_REGION=ap-southeast-2
# UORCA_BEDROCK_PROFILE=your-aws-profile
# UORCA_BEDROCK_MODEL_PREFIX=au.
#
# Hosted APIs, selected by a "<provider>:<model>" string:
# UORCA_AI_PROVIDER=anthropic:<model>       ANTHROPIC_API_KEY=<key>
# UORCA_AI_PROVIDER=google-gla:<model>      GEMINI_API_KEY=<key>   (or GOOGLE_API_KEY)
# UORCA_AI_PROVIDER=google-vertex:<model>   GOOGLE_CLOUD_PROJECT=<project>  (+ gcloud ADC)
# UORCA_AI_PROVIDER=groq:<model>            GROQ_API_KEY=<key>
# UORCA_AI_PROVIDER=mistral:<model>         MISTRAL_API_KEY=<key>
# UORCA_AI_PROVIDER=cohere:<model>          CO_API_KEY=<key>   (not usable with the locked versions yet)
#
# Azure OpenAI:
# UORCA_AI_PROVIDER=azure
# AZURE_OPENAI_API_KEY=<key>
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# OPENAI_API_VERSION=2024-10-21
# UORCA_AZURE_DEPLOYMENT=<deployment-name>
#
# OpenAI-compatible server (vLLM, Ollama, LM Studio, OpenRouter, Together, Fireworks, DeepSeek):
# UORCA_AI_PROVIDER=openai_compatible
# UORCA_OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
# UORCA_OPENAI_COMPATIBLE_MODEL=qwen3:8b
# UORCA_OPENAI_COMPATIBLE_API_KEY_ENV=OPENROUTER_API_KEY   # name of the variable holding the key; omit if none
