# UORCA Environment Configuration Template
# ========================================
# Copy this file to '.env' and fill in your actual values
# Keep this file secure and never commit it to version control!

# Required: Your email address (NCBI Entrez API requirement)
# Any valid email address - required by NCBI guidelines for API access
ENTREZ_EMAIL=your.email@institution.edu

# Required: OpenAI API key for AI-powered analysis
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=<your-openai-api-key>

# Optional but recommended: NCBI API key for faster processing
# Get your FREE key from: https://www.ncbi.nlm.nih.gov/account/settings/
# Benefits: 10x faster database queries (10 req/sec vs 3 req/sec)
# Leave it commented out until you have a real key: a placeholder is rejected by NCBI.
# ENTREZ_API_KEY=your-ncbi-api-key-here

# Optional: choose the LLM (see "Choosing the AI model" in README.md)
# Precedence: these variables, then ~/.uorca/config.yaml (written by the app's
# Project Setup page), then the built-in default (OpenAI, gpt-5-mini).
# UORCA_AI_PROVIDER=openai          # or "bedrock"
# UORCA_OPENAI_MODEL=gpt-5-mini
# AWS Bedrock (needs AWS credentials, e.g. an AWS profile):
# UORCA_BEDROCK_MODEL=anthropic.claude-sonnet-4-5-20250929-v1:0
# UORCA_BEDROCK_REGION=ap-southeast-2
# UORCA_BEDROCK_PROFILE=your-aws-profile
# UORCA_BEDROCK_MODEL_PREFIX=au.
